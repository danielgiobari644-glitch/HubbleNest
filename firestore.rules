rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // Helper functions
    // ======================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Null-safe string field read.
    //
    // Legacy documents created by earlier app versions may be missing fields
    // (or hold them under a different type). Dereferencing a missing field
    // with dot notation (resource.data.senderId) raises an ERROR inside the
    // rules engine, and a raised error always DENIES the operation — even if
    // every other condition matches. That turned into
    // "Missing or insufficient permissions" for old conversations/requests
    // and could NOT be fixed by republishing rules, because the data itself
    // was the problem. Map.get(key, default) reads the field without ever
    // raising, so legacy data degrades to "no access" instead of "hard error".
    function fieldStr(data, key) {
      return data.get(key, '') is string ? data.get(key, '') : '';
    }

    // Null-safe participant check for a 1-to-1 conversation document.
    // Non-existent conversations deny (they have no participants at all);
    // existing ones only grant when the caller is a participant.
    function isConversationParticipant(convId) {
      return exists(/databases/$(database)/documents/conversations/$(convId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.get('participants', []);
    }

    // Does this update ONLY touch the given counter fields?
    // Used to let any member bump engagement counters (likes / plays)
    // without granting full edit rights on the document.
    function touchesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isSupportSpace(spaceId) {
      return (exists(/databases/$(database)/documents/spaces/$(spaceId)) &&
        (get(/databases/$(database)/documents/spaces/$(spaceId)).data.get('codeUpper', '') == 'HN-JM96Q7' ||
         get(/databases/$(database)/documents/spaces/$(spaceId)).data.get('isOfficialSupport', false) == true ||
         spaceId == 'hubblenest-support'));
    }

    function isSpaceMember(spaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) ||
        isSupportSpace(spaceId)
      );
    }

    function isSpaceAdmin(spaceId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        (exists(/databases/$(database)/documents/spaces/$(spaceId)) &&
         get(/databases/$(database)/documents/spaces/$(spaceId)).data.get('createdBy', '') == request.auth.uid)
      );
    }

    // ======================================================================
    // User Profiles
    // ======================================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false;
    }

    // FCM device tokens — used to deliver background Web Push notifications.
    // Owners manage their own devices; any signed-in member may read tokens
    // in order to send them a push via Firebase Cloud Messaging (HTTP v1).
    match /users/{userId}/pushTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      // Any member may prune dead device tokens discovered while sending pushes
      allow delete: if isAuthenticated();
    }

    // App configuration (push sender credentials + AI game builder key).
    // The `push` document holds the Web Push certificate key and (optionally)
    // the background-push service account. The `ai` document holds the
    // Gemini API key + model for the Arcade's AI Game Builder. Both are
    // configured ONCE from the app's Settings page and live in Firestore —
    // so redeploying the app never resets them.
    // Ownership model: the FIRST signed-in member to save the config claims it
    // (ownerUid); afterwards only that member can change it. Reads stay
    // authenticated (the VAPID public key is public by design; the service
    // account / API key fields are documented as members-visible by
    // architecture — use dedicated, least-privilege credentials and rotate
    // them if ever needed).
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        docId in ['push', 'ai'] &&
        fieldStr(request.resource.data, 'ownerUid') == request.auth.uid;
      allow update: if isAuthenticated() &&
        docId in ['push', 'ai'] &&
        fieldStr(resource.data, 'ownerUid') == request.auth.uid;
      allow delete: if false;
    }

    // ======================================================================
    // Contacts — People page relationships (owner-added members by username)
    // Doc id: {ownerUid}_{contactUid}; only the owner can read/write their
    // own contacts. The id-prefix check prevents forging someone else's list.
    // ======================================================================
    match /contacts/{contactId} {
      // Single-doc reads and per-doc writes check the doc-id prefix.
      allow get: if isAuthenticated() && contactId.split('_')[0] == request.auth.uid;
      // LIST (the People page's live subscription) must be verifiable from the
      // query itself — the app always queries where ownerUid == auth.uid, so
      // the engine can prove every result satisfies this rule.
      allow list: if isAuthenticated() &&
        resource.data.get('ownerUid', '') == request.auth.uid;
      allow create: if isAuthenticated() &&
        contactId.split('_')[0] == request.auth.uid &&
        contactId == fieldStr(request.resource.data, 'ownerUid') + '_' + fieldStr(request.resource.data, 'uid') &&
        fieldStr(request.resource.data, 'ownerUid') == request.auth.uid &&
        fieldStr(request.resource.data, 'uid') != request.auth.uid;
      allow update: if isAuthenticated() &&
        contactId.split('_')[0] == request.auth.uid &&
        fieldStr(resource.data, 'ownerUid') == request.auth.uid;
      allow delete: if isAuthenticated() &&
        contactId.split('_')[0] == request.auth.uid;
    }

    // ======================================================================
    // Spaces
    // ======================================================================
    match /spaces/{spaceId} {
      // Public intro: a Space is readable by signed-out visitors ONLY when its
      // admin explicitly set isPublic:true — and only the space doc (name,
      // description, code for the join button, member count) is exposed.
      allow get: if isAuthenticated() || resource.data.get('isPublic', false) == true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSpaceAdmin(spaceId) || (isSupportSpace(spaceId) && isAuthenticated());
      allow delete: if isSpaceAdmin(spaceId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        // INSTANT JOIN: a member with a valid code adds THEMSELVES
        // (isUser(memberId) — the code is validated in the app before the
        // write is attempted); space admins add members from their contacts.
        allow create: if isSpaceAdmin(spaceId) || isUser(memberId);
        allow update: if isSpaceAdmin(spaceId);
        allow delete: if isSpaceAdmin(spaceId) || isUser(memberId);
      }

      // Legacy join-approval queue: kept ONLY so old data can still be read
      // or cleaned up. The app no longer creates pending join requests.
      match /joinRequests/{requestId} {
        allow read: if isAuthenticated() && (isUser(requestId) || isSpaceAdmin(spaceId));
        allow create: if isUser(requestId);
        allow update, delete: if isSpaceAdmin(spaceId) || isUser(requestId);
      }

      // Public messages within a space
      match /messages/{messageId} {
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId);
        allow update: if isSpaceMember(spaceId);
        allow delete: if isSpaceAdmin(spaceId) || (isAuthenticated() && fieldStr(resource.data, 'senderId') == request.auth.uid);
      }

      // Files within a space
      match /files/{fileId} {
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId);
        allow delete: if isSpaceAdmin(spaceId) || (isAuthenticated() && fieldStr(resource.data, 'uploadedBy') == request.auth.uid);
      }

      // Announcements within a space
      match /announcements/{announcementId} {
        allow read: if isSpaceMember(spaceId);
        allow create, update, delete: if isSpaceAdmin(spaceId);
      }

      // Links within a space
      match /links/{linkId} {
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId);
        allow delete: if isSpaceAdmin(spaceId) || (isAuthenticated() && fieldStr(resource.data, 'senderId') == request.auth.uid);
      }
    }

    // ======================================================================
    // Notifications
    // ======================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && fieldStr(resource.data, 'userId') == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && fieldStr(resource.data, 'userId') == request.auth.uid;
      allow delete: if isAuthenticated() && fieldStr(resource.data, 'userId') == request.auth.uid;
    }

    // ======================================================================
    // Private Chat Requests
    //
    // IMPORTANT: the app calls getDoc() on chatRequests/{uidA_uidB} to CHECK
    // whether a request already exists between two members. When the document
    // does NOT exist, Firestore evaluates the rule with `resource == null` —
    // a rule that dereferences resource.data errors out and DENIES the read,
    // which broke the entire chat-request flow with
    // "Missing or insufficient permissions". Non-existent documents carry no
    // data, so reading them is harmless and must be allowed. Both the
    // existence check and the field reads are null-safe (see fieldStr).
    // ======================================================================
    match /chatRequests/{requestId} {
      allow get: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/chatRequests/$(requestId)) ||
        fieldStr(get(/databases/$(database)/documents/chatRequests/$(requestId)).data, 'senderId') == request.auth.uid ||
        fieldStr(get(/databases/$(database)/documents/chatRequests/$(requestId)).data, 'receiverId') == request.auth.uid
      );
      // Queries always target existing documents only
      allow list: if isAuthenticated() && (
        fieldStr(resource.data, 'senderId') == request.auth.uid ||
        fieldStr(resource.data, 'receiverId') == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'senderId') == request.auth.uid;
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/chatRequests/$(requestId)) && (
          fieldStr(resource.data, 'receiverId') == request.auth.uid ||
          fieldStr(resource.data, 'senderId') == request.auth.uid
        );
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/chatRequests/$(requestId)) ||
        fieldStr(resource.data, 'senderId') == request.auth.uid ||
        fieldStr(resource.data, 'receiverId') == request.auth.uid
      );
    }

    // ======================================================================
    // Direct 1-to-1 Conversations
    //
    // Like chatRequests above: the app getDoc()s the conversation to check
    // whether one already exists before creating it. That existence check
    // must be allowed to return an empty snapshot when the conversation is
    // new. All participant checks use Map.get('participants', []) so that
    // legacy conversation documents without the field fail CLOSED (deny)
    // instead of raising an error inside the rules engine.
    // ======================================================================
    match /conversations/{conversationId} {
      allow get: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', [])
      );
      allow list: if isAuthenticated() && request.auth.uid in resource.data.get('participants', []);
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.get('participants', []);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.get('participants', []);
      allow delete: if false;

      // Encrypted Private Messages
      //
      // The messages LISTENER can attach in the tiny window while the
      // conversation document is still being created (open a brand-new DM).
      // get() on a non-existent document ERRORS inside rules — the same
      // class of problem as chatRequests above — so the read must be
      // null-safe. A non-existent conversation has an empty messages
      // subcollection, so allowing that read exposes nothing; an EXISTING
      // conversation still strictly requires participation.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', [])
        );
        allow create: if isAuthenticated() &&
          isConversationParticipant(conversationId) &&
          fieldStr(request.resource.data, 'senderId') == request.auth.uid;
        allow delete: if isAuthenticated() && fieldStr(resource.data, 'senderId') == request.auth.uid;
      }
    }

    // ======================================================================
    // Community Feed (Home)
    //
    // Public posts among signed-in members, with likes (likedBy array of
    // uids — O(1) liked-state for every client without extra reads) and a
    // comments subcollection. Any member may bump engagement counters
    // (likeCount / commentCount), but ONLY those fields.
    // ======================================================================
    match /feedPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'authorId') == request.auth.uid;
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'authorId') == request.auth.uid ||
        touchesOnly(['likeCount', 'commentCount', 'likedBy'])
      );
      allow delete: if isAuthenticated() &&
        fieldStr(resource.data, 'authorId') == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          fieldStr(request.resource.data, 'authorId') == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          fieldStr(resource.data, 'authorId') == request.auth.uid;
      }
    }

    // ======================================================================
    // Arcade (user-created HTML/CSS/JS games)
    //
    // Game source code lives in the document (html/css/js strings, capped by
    // the app at a few hundred KB — well under Firestore's 1 MiB doc limit).
    // Any member may bump the play counter, but ONLY that field. Likes use
    // the same likedBy pattern as the feed.
    // ======================================================================
    // Opt-in public posts: a mirror of a feed post with ONLY public fields,
    // written by the author when they tick "Public web page". Readable by
    // ANYONE (the public website is signed-out), writable only by the author.
    match /publicPosts/{postId} {
      allow read: if true;
      // A public page can only exist for a feed post the caller owns.
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/feedPosts/$(postId)) &&
        fieldStr(get(/databases/$(database)/documents/feedPosts/$(postId)).data, 'authorId') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/feedPosts/$(postId)) &&
        fieldStr(get(/databases/$(database)/documents/feedPosts/$(postId)).data, 'authorId') == request.auth.uid;
    }

    match /games/{gameId} {
      // Public game pages: a single game is readable signed-out ONLY when the
      // author set isPublic:true. Listing still requires sign-in.
      allow get: if isAuthenticated() || resource.data.get('isPublic', false) == true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'authorId') == request.auth.uid;
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'authorId') == request.auth.uid ||
        touchesOnly(['plays', 'likedBy'])
      );
      allow delete: if isAuthenticated() &&
        fieldStr(resource.data, 'authorId') == request.auth.uid;
    }

    // ======================================================================
    // Direct Share (file handoff via 6-character code or QR link)
    //
    // The document ID IS the share code (unguessable: 31^6 ≈ 887 million
    // combinations, generated with crypto.getRandomValues). Anyone signed in
    // may READ a share (they must present the code anyway), but only the
    // owner can add/remove files or close the share. File bytes live on
    // Cloudinary; Firestore only stores metadata.
    // ======================================================================
    match /directShares/{shareId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'ownerId') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        fieldStr(resource.data, 'ownerId') == request.auth.uid;
    }

    // ======================================================================
    // Secure in-app file store (fileBlobs)
    //
    // Real file BYTES (base64 chunks) for attachments when Cloudinary accepts
    // an upload but the account's security setting blocks its DELIVERY
    // (401 "deny or ACL failure" on PDF/ZIP). The uploader stores bytes;
    // any signed-in member can read them (same visibility as Cloudinary
    // public URLs). Every chunk repeats ownerId so writes never need a get()
    // on the parent — a batch that creates parent + chunks atomically
    // validates against the request itself.
    // ======================================================================
    match /fileBlobs/{blobId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'ownerId') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        fieldStr(resource.data, 'ownerId') == request.auth.uid;

      match /chunks/{chunkId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated() &&
          fieldStr(request.resource.data, 'ownerId') == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          fieldStr(resource.data, 'ownerId') == request.auth.uid;
      }
    }
  }
}
