rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // Helper functions
    // ======================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The HubbleNest creator/admin — full platform moderation powers.
    // Matches on the AUTH EMAIL (never client-writable), so no other member
    // can ever acquire these rights by editing their own profile document.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'danielgiobari644@gmail.com';
    }

    // Is this account currently banned or inside a suspension window?
    // Suspensions use suspendedUntilMs (epoch millis int) so the comparison
    // never depends on Timestamp coercion; missing fields fail OPEN (null-safe).
    function banActive(userData) {
      return userData.get('banned', false) == true ||
        (userData.get('suspendedUntilMs', 0) is int &&
         userData.get('suspendedUntilMs', 0) > request.time.toMillis());
    }

    function isBannedNow() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        banActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // FRIEND REQUEST GATE: a private conversation may only be CREATED when an
    // accepted chat/friend request exists between the two members (in either
    // direction). Existing conversations are unaffected — the gate applies to
    // creation only, so legacy friend pairs keep working.
    function pairRequestAccepted(senderUid, receiverUid) {
      return exists(/databases/$(database)/documents/chatRequests/$(senderUid + '_' + receiverUid)) &&
        get(/databases/$(database)/documents/chatRequests/$(senderUid + '_' + receiverUid)).data.get('status', '') == 'accepted';
    }

    function hasAcceptedChatRequestWith(otherUid) {
      return pairRequestAccepted(request.auth.uid, otherUid) ||
        pairRequestAccepted(otherUid, request.auth.uid);
    }

    function otherParticipantOf(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    // Null-safe string field read.
    //
    // Legacy documents created by earlier app versions may be missing fields
    // (or hold them under a different type). Dereferencing a missing field
    // with dot notation (resource.data.senderId) raises an ERROR inside the
    // rules engine, and a raised error always DENIES the operation — even if
    // every other condition matches. That turned into
    // "Missing or insufficient permissions" for old conversations/requests
    // and could NOT be fixed by republishing rules, because the data itself
    // was the problem. Map.get(key, default) reads the field without ever
    // raising, so legacy data degrades to "no access" instead of "hard error".
    function fieldStr(data, key) {
      return data.get(key, '') is string ? data.get(key, '') : '';
    }

    // Null-safe participant check for a 1-to-1 conversation document.
    // Non-existent conversations deny (they have no participants at all);
    // existing ones only grant when the caller is a participant.
    function isConversationParticipant(convId) {
      return exists(/databases/$(database)/documents/conversations/$(convId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.get('participants', []);
    }

    // Does this update ONLY touch the given counter fields?
    // Used to let any member bump engagement counters (likes / plays)
    // without granting full edit rights on the document.
    function touchesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isSupportSpace(spaceId) {
      return (exists(/databases/$(database)/documents/spaces/$(spaceId)) &&
        (get(/databases/$(database)/documents/spaces/$(spaceId)).data.get('codeUpper', '') == 'HN-JM96Q7' ||
         get(/databases/$(database)/documents/spaces/$(spaceId)).data.get('isOfficialSupport', false) == true ||
         spaceId == 'hubblenest-support'));
    }

    function isSpaceMember(spaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) ||
        isSupportSpace(spaceId)
      );
    }

    function isSpaceAdmin(spaceId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        (exists(/databases/$(database)/documents/spaces/$(spaceId)) &&
         get(/databases/$(database)/documents/spaces/$(spaceId)).data.get('createdBy', '') == request.auth.uid)
      );
    }

    // ======================================================================
    // User Profiles
    // ======================================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId);
      // The platform admin may write moderation flags (banned / suspendedUntilMs /
      // reasons) on any profile; regular members may update their own profile but
      // can NEVER touch the moderation fields (no self-unban), even by accident.
      allow update: if isAdmin() || (isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['banned', 'suspendedUntilMs', 'banReason', 'suspensionReason']));
      allow delete: if false;
    }

    // FCM device tokens — used to deliver background Web Push notifications.
    // Owners manage their own devices; any signed-in member may read tokens
    // in order to send them a push via Firebase Cloud Messaging (HTTP v1).
    match /users/{userId}/pushTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      // Any member may prune dead device tokens discovered while sending pushes
      allow delete: if isAuthenticated();
    }

    // App configuration (push sender credentials + AI game builder key).
    // The `push` document holds the Web Push certificate key and (optionally)
    // the background-push service account. The `ai` document holds the
    // Gemini API key + model for the Arcade's AI Game Builder. Both are
    // configured ONCE from the app's Settings page and live in Firestore —
    // so redeploying the app never resets them.
    // Ownership model: the FIRST signed-in member to save the config claims it
    // (ownerUid); afterwards only that member can change it. Reads stay
    // authenticated (the VAPID public key is public by design; the service
    // account / API key fields are documented as members-visible by
    // architecture — use dedicated, least-privilege credentials and rotate
    // them if ever needed).
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        docId in ['push', 'ai'] &&
        (fieldStr(request.resource.data, 'ownerUid') == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() &&
        docId in ['push', 'ai'] &&
        (fieldStr(resource.data, 'ownerUid') == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // ======================================================================
    // Contacts — People page relationships (owner-added members by username)
    // Doc id: {ownerUid}_{contactUid}; only the owner can read/write their
    // own contacts. The id-prefix check prevents forging someone else's list.
    // ======================================================================
    match /contacts/{contactId} {
      // Single-doc reads and per-doc writes check the doc-id prefix.
      allow get: if isAuthenticated() && contactId.split('_')[0] == request.auth.uid;
      // LIST (the People page's live subscription) must be verifiable from the
      // query itself — the app always queries where ownerUid == auth.uid, so
      // the engine can prove every result satisfies this rule.
      allow list: if isAuthenticated() &&
        resource.data.get('ownerUid', '') == request.auth.uid;
      allow create: if isAuthenticated() &&
        contactId.split('_')[0] == request.auth.uid &&
        contactId == fieldStr(request.resource.data, 'ownerUid') + '_' + fieldStr(request.resource.data, 'uid') &&
        fieldStr(request.resource.data, 'ownerUid') == request.auth.uid &&
        fieldStr(request.resource.data, 'uid') != request.auth.uid;
      allow update: if isAuthenticated() &&
        contactId.split('_')[0] == request.auth.uid &&
        fieldStr(resource.data, 'ownerUid') == request.auth.uid;
      allow delete: if isAuthenticated() &&
        contactId.split('_')[0] == request.auth.uid;
    }

    // ======================================================================
    // Spaces
    // ======================================================================
    match /spaces/{spaceId} {
      // Public intro: a Space is readable by signed-out visitors ONLY when its
      // admin explicitly set isPublic:true — and only the space doc (name,
      // description, code for the join button, member count) is exposed.
      allow get: if isAuthenticated() || resource.data.get('isPublic', false) == true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && !isBannedNow();
      // The platform admin can update any Space (feature it, ban/suspend it)
      // and delete any Space outright.
      allow update: if isSpaceAdmin(spaceId) || isAdmin() || (isSupportSpace(spaceId) && isAuthenticated());
      allow delete: if isSpaceAdmin(spaceId) || isAdmin();

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        // INSTANT JOIN: a member with a valid code adds THEMSELVES
        // (isUser(memberId) — the code is validated in the app before the
        // write is attempted); space admins add members from their contacts.
        allow create: if !isBannedNow() && (isSpaceAdmin(spaceId) || isUser(memberId));
        allow update: if isSpaceAdmin(spaceId) || isAdmin();
        // Space admins (and the platform admin) remove members; members can
        // always LEAVE a Space themselves.
        allow delete: if isSpaceAdmin(spaceId) || isUser(memberId) || isAdmin();
      }

      // Legacy join-approval queue: kept ONLY so old data can still be read
      // or cleaned up. The app no longer creates pending join requests.
      match /joinRequests/{requestId} {
        allow read: if isAuthenticated() && (isUser(requestId) || isSpaceAdmin(spaceId));
        allow create: if isUser(requestId);
        allow update, delete: if isSpaceAdmin(spaceId) || isUser(requestId);
      }

      // Public messages within a space
      match /messages/{messageId} {
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId) && !isBannedNow();
        allow update: if isSpaceMember(spaceId);
        allow delete: if isSpaceAdmin(spaceId) || isAdmin() || (isAuthenticated() && fieldStr(resource.data, 'senderId') == request.auth.uid);
      }

      // Files within a space
      match /files/{fileId} {
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId) && !isBannedNow();
        allow delete: if isSpaceAdmin(spaceId) || isAdmin() || (isAuthenticated() && fieldStr(resource.data, 'uploadedBy') == request.auth.uid);
      }

      // Announcements within a space
      match /announcements/{announcementId} {
        allow read: if isSpaceMember(spaceId);
        allow create, update, delete: if isSpaceAdmin(spaceId);
      }

      // Links within a space
      match /links/{linkId} {
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId);
        allow delete: if isSpaceAdmin(spaceId) || (isAuthenticated() && fieldStr(resource.data, 'senderId') == request.auth.uid);
      }
    }

    // ======================================================================
    // Notifications
    // ======================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && fieldStr(resource.data, 'userId') == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && fieldStr(resource.data, 'userId') == request.auth.uid;
      allow delete: if isAuthenticated() && fieldStr(resource.data, 'userId') == request.auth.uid;
    }

    // ======================================================================
    // Private Chat Requests
    //
    // IMPORTANT: the app calls getDoc() on chatRequests/{uidA_uidB} to CHECK
    // whether a request already exists between two members. When the document
    // does NOT exist, Firestore evaluates the rule with `resource == null` —
    // a rule that dereferences resource.data errors out and DENIES the read,
    // which broke the entire chat-request flow with
    // "Missing or insufficient permissions". Non-existent documents carry no
    // data, so reading them is harmless and must be allowed. Both the
    // existence check and the field reads are null-safe (see fieldStr).
    // ======================================================================
    match /chatRequests/{requestId} {
      allow get: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/chatRequests/$(requestId)) ||
        fieldStr(get(/databases/$(database)/documents/chatRequests/$(requestId)).data, 'senderId') == request.auth.uid ||
        fieldStr(get(/databases/$(database)/documents/chatRequests/$(requestId)).data, 'receiverId') == request.auth.uid
      );
      // Queries always target existing documents only
      allow list: if isAuthenticated() && (
        fieldStr(resource.data, 'senderId') == request.auth.uid ||
        fieldStr(resource.data, 'receiverId') == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'senderId') == request.auth.uid &&
        !isBannedNow();
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/chatRequests/$(requestId)) && (
          fieldStr(resource.data, 'receiverId') == request.auth.uid ||
          fieldStr(resource.data, 'senderId') == request.auth.uid
        );
      allow delete: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/chatRequests/$(requestId)) ||
        fieldStr(resource.data, 'senderId') == request.auth.uid ||
        fieldStr(resource.data, 'receiverId') == request.auth.uid
      );
    }

    // ======================================================================
    // Direct 1-to-1 Conversations
    //
    // Like chatRequests above: the app getDoc()s the conversation to check
    // whether one already exists before creating it. That existence check
    // must be allowed to return an empty snapshot when the conversation is
    // new. All participant checks use Map.get('participants', []) so that
    // legacy conversation documents without the field fail CLOSED (deny)
    // instead of raising an error inside the rules engine.
    // ======================================================================
    match /conversations/{conversationId} {
      allow get: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', [])
      );
      allow list: if isAuthenticated() && request.auth.uid in resource.data.get('participants', []);
      // CREATION GATE: a NEW conversation requires an ACCEPTED friend/chat
      // request between the two participants (either direction). Knowing a
      // username — even an exact one — is never enough to open a chat.
      allow create: if isAuthenticated() &&
        !isBannedNow() &&
        request.resource.data.get('participants', []).size() == 2 &&
        request.auth.uid in request.resource.data.get('participants', []) &&
        hasAcceptedChatRequestWith(otherParticipantOf(request.resource.data.get('participants', [])));
      allow update: if isAuthenticated() && request.auth.uid in resource.data.get('participants', []);
      allow delete: if false;

      // Encrypted Private Messages
      //
      // The messages LISTENER can attach in the tiny window while the
      // conversation document is still being created (open a brand-new DM).
      // get() on a non-existent document ERRORS inside rules — the same
      // class of problem as chatRequests above — so the read must be
      // null-safe. A non-existent conversation has an empty messages
      // subcollection, so allowing that read exposes nothing; an EXISTING
      // conversation still strictly requires participation.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', [])
        );
        allow create: if isAuthenticated() &&
          isConversationParticipant(conversationId) &&
          fieldStr(request.resource.data, 'senderId') == request.auth.uid;
        allow delete: if isAuthenticated() && fieldStr(resource.data, 'senderId') == request.auth.uid;
      }
    }

    // ======================================================================
    // Community Feed (Home)
    //
    // Public posts among signed-in members, with likes (likedBy array of
    // uids — O(1) liked-state for every client without extra reads) and a
    // comments subcollection. Any member may bump engagement counters
    // (likeCount / commentCount), but ONLY those fields.
    // ======================================================================
    match /feedPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'authorId') == request.auth.uid &&
        !isBannedNow();
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'authorId') == request.auth.uid ||
        touchesOnly(['likeCount', 'commentCount', 'likedBy', 'shareCount'])
      );
      // Authors delete their own posts; the platform admin can delete ANY post.
      allow delete: if isAdmin() || (isAuthenticated() &&
        fieldStr(resource.data, 'authorId') == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          fieldStr(request.resource.data, 'authorId') == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          fieldStr(resource.data, 'authorId') == request.auth.uid;
      }
    }

    // ======================================================================
    // Arcade (user-created HTML/CSS/JS games)
    //
    // Game source code lives in the document (html/css/js strings, capped by
    // the app at a few hundred KB — well under Firestore's 1 MiB doc limit).
    // Any member may bump the play counter, but ONLY that field. Likes use
    // the same likedBy pattern as the feed.
    // ======================================================================
    // Opt-in public posts: a mirror of a feed post with ONLY public fields,
    // written by the author when they tick "Public web page". Readable by
    // ANYONE (the public website is signed-out), writable only by the author.
    match /publicPosts/{postId} {
      allow read: if true;
      // A public page can only exist for a feed post the caller owns.
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/feedPosts/$(postId)) &&
        fieldStr(get(/databases/$(database)/documents/feedPosts/$(postId)).data, 'authorId') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/feedPosts/$(postId)) &&
        fieldStr(get(/databases/$(database)/documents/feedPosts/$(postId)).data, 'authorId') == request.auth.uid;
    }

    match /games/{gameId} {
      // Public game pages: a single game is readable signed-out ONLY when the
      // author set isPublic:true. Listing still requires sign-in.
      allow get: if isAuthenticated() || resource.data.get('isPublic', false) == true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'authorId') == request.auth.uid &&
        !isBannedNow();
      // v31: the platform admin can manage EVERY game (edit code, re-skin the
      // cover/logo, fix metadata). The admin edit path deliberately does NOT
      // touch the author fields, so ownership is preserved.
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'authorId') == request.auth.uid ||
        touchesOnly(['plays', 'likedBy', 'commentCount', 'ratingSum', 'ratingCount']) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isAuthenticated() &&
        fieldStr(resource.data, 'authorId') == request.auth.uid);

      // v30: the game's SOURCE CODE lives here (games/{id}/code/main) so the
      // Arcade's realtime browse list stays light. Same visibility as the
      // parent game; the author writes it (creation/migration/edits) and —
      // v31 — the platform admin too (admin edit of any game's code).
      match /code/{codeDocId} {
        allow get, list: if isAuthenticated() ||
          (get(/databases/$(database)/documents/games/$(gameId)).data.get('isPublic', false) == true);
        allow create, update, delete: if isAuthenticated() &&
          !isBannedNow() &&
          (get(/databases/$(database)/documents/games/$(gameId)).data.get('authorId', '') == request.auth.uid ||
           isAdmin());
      }
    }

    // ======================================================================
    // Arcade 2.0 — ratings, comments, bookmarks, play sessions, scores
    //
    // TRUST MODEL (no Cloud Functions available — this is the strongest
    // client-only chain we can build, and it is honest about it):
    //  - Ratings: one doc per (game,user); stars must be an int 1..5 and
    //    the doc id must match the payload, so a rater can only ever move
    //    their own rating.
    //  - Scores: one doc per (game,user), id-anchored. A write must carry
    //    a sessionId that resolves to a REAL gameSessions doc owned by the
    //    same uid for the SAME game (two validated get()s), the score must
    //    be a bounded integer, and updates may never LOWER a score.
    //  - Sessions: private per user; they anchor score submissions and
    //    power "Recently Played". A refresh within the resume window reuses
    //    the same session instead of double-counting a play.
    //  - Comments: same likedBy pattern as the feed; only likedBy may be
    //    touched by non-authors.
    //  - Bookmarks: one doc per (user,game); users only touch their own.
    // ======================================================================

    match /gameRatings/{ratingId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.gameId is string &&
        request.resource.data.gameId.size() >= 1 && request.resource.data.gameId.size() <= 80 &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 && request.resource.data.stars <= 5 &&
        ratingId == request.resource.data.uid + '_' + request.resource.data.gameId;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    match /gameComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'authorId') == request.auth.uid &&
        fieldStr(request.resource.data, 'gameId').size() >= 1 &&
        fieldStr(request.resource.data, 'gameId').size() <= 80 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 600;
      // Authors edit/delete their own comments; anyone may toggle ONLY the
      // like array on someone else's comment.
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'authorId') == request.auth.uid ||
        touchesOnly(['likedBy'])
      );
      allow delete: if isAuthenticated() &&
        fieldStr(resource.data, 'authorId') == request.auth.uid;
    }

    match /gameBookmarks/{bookmarkId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.gameId is string &&
        request.resource.data.gameId.size() >= 1 && request.resource.data.gameId.size() <= 80 &&
        bookmarkId == request.resource.data.uid + '_' + request.resource.data.gameId;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    match /gameSessions/{sessionId} {
      // Play sessions are PRIVATE to the player: they anchor score trust.
      allow get, list: if isAuthenticated() &&
        (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'uid') == request.auth.uid &&
        fieldStr(request.resource.data, 'gameId').size() >= 1 &&
        fieldStr(request.resource.data, 'gameId').size() <= 80 &&
        request.resource.data.durationSec is int &&
        request.resource.data.lastScore is int;
      allow update: if isAuthenticated() &&
        fieldStr(resource.data, 'uid') == request.auth.uid &&
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['endedAt', 'durationSec', 'lastScore', 'resumedAt', 'endReason']));
      allow delete: if isAuthenticated() &&
        fieldStr(resource.data, 'uid') == request.auth.uid;
    }

    match /gameScores/{scoreId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.gameId is string &&
        request.resource.data.gameId.size() >= 1 && request.resource.data.gameId.size() <= 80 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 10000000 &&
        request.resource.data.sessionId is string &&
        request.resource.data.displayName is string &&
        scoreId == request.resource.data.uid + '_' + request.resource.data.gameId &&
        exists(/databases/$(database)/documents/gameSessions/$(request.resource.data.sessionId)) &&
        get(/databases/$(database)/documents/gameSessions/$(request.resource.data.sessionId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/gameSessions/$(request.resource.data.sessionId)).data.gameId == request.resource.data.gameId;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.score is int &&
        request.resource.data.score >= resource.data.score &&
        request.resource.data.score <= 10000000 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['score', 'displayName', 'photo', 'sessionId', 'updatedAt']);
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    // ======================================================================
    // HubbleNest Bots — AI bot marketplace
    //
    // VISIBILITY IS A REAL BOUNDARY: a single bot doc is readable signed-out
    // or by other members ONLY when visibility == 'public'. Private bots are
    // owner-only (plus the platform admin) at the RULES level — knowing a bot
    // id or its share URL grants nothing. Listing queries must filter by
    // visibility (the app always does: where('visibility','==','public')) or
    // by ownerUid, so every result is individually provable.
    //
    // Counter trust (same model as the Arcade): any signed-in member may bump
    // ONLY the aggregate fields through updateDoc — usage tracking happens on
    // the first conversation with a bot, ratings through the id-anchored
    // botRatings transaction, comment counts on real comment writes. Nothing
    // else on the document may be touched by a non-owner.
    // ======================================================================
    match /bots/{botId} {
      allow get: if isAuthenticated() && (
        resource.data.get('visibility', '') == 'public' ||
        fieldStr(resource.data, 'ownerUid') == request.auth.uid ||
        isAdmin());
      // Listing is provably safe only for constrained queries: the
      // marketplace/search must filter visibility == 'public', and "my bots"
      // must filter ownerUid == the caller. A bare listing (which would leak
      // PRIVATE bots' full configuration to any member) is rejected.
      allow list: if isAuthenticated() && (
        resource.data.get('visibility', '') == 'public' ||
        fieldStr(resource.data, 'ownerUid') == request.auth.uid ||
        isAdmin());
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'ownerUid') == request.auth.uid &&
        !isBannedNow() &&
        fieldStr(request.resource.data, 'name').size() >= 1 &&
        fieldStr(request.resource.data, 'name').size() <= 60 &&
        fieldStr(request.resource.data, 'visibility') in ['public', 'private'] &&
        (request.resource.data.get('usageCount', 0) == 0 &&
         request.resource.data.get('ratingSum', 0) == 0 &&
         request.resource.data.get('ratingCount', 0) == 0);
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'ownerUid') == request.auth.uid ||
        isAdmin() ||
        touchesOnly(['usageCount', 'lastUsedAt', 'ratingSum', 'ratingCount', 'commentCount']));
      allow delete: if isAdmin() || (isAuthenticated() &&
        fieldStr(resource.data, 'ownerUid') == request.auth.uid);
    }

    // One rating per member per bot (doc id = uid_botId, mirrors gameRatings).
    match /botRatings/{ratingId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.botId is string &&
        request.resource.data.botId.size() >= 1 && request.resource.data.botId.size() <= 80 &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 && request.resource.data.stars <= 5 &&
        ratingId == request.resource.data.uid + '_' + request.resource.data.botId;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    // Public reviews on public bots. The app only writes comments to bots it
    // can read (visibility == public), so reads are member-wide.
    match /botComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'authorId') == request.auth.uid &&
        fieldStr(request.resource.data, 'botId').size() >= 1 &&
        fieldStr(request.resource.data, 'botId').size() <= 80 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 600;
      allow update: if isAuthenticated() && (
        fieldStr(resource.data, 'authorId') == request.auth.uid ||
        touchesOnly(['likedBy']));
      // Authors and the platform admin moderate comments.
      allow delete: if isAdmin() || (isAuthenticated() &&
        fieldStr(resource.data, 'authorId') == request.auth.uid);
    }

    // Private per-member conversations with a bot. Doc id = uid_botId and
    // every write repeats uid, so ownership is verifiable from the request
    // itself. Messages inherit the same ownership through the parent get().
    match /botChats/{chatId} {
      allow get, list: if isAuthenticated() && (
        chatId.split('_')[0] == request.auth.uid ||
        (resource != null && fieldStr(resource.data, 'uid') == request.auth.uid));
      allow create: if isAuthenticated() &&
        chatId.split('_')[0] == request.auth.uid &&
        fieldStr(request.resource.data, 'uid') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        chatId.split('_')[0] == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          (chatId.split('_')[0] == request.auth.uid ||
           (exists(/databases/$(database)/documents/botChats/$(chatId)) &&
            fieldStr(get(/databases/$(database)/documents/botChats/$(chatId)).data, 'uid') == request.auth.uid));
        allow create: if isAuthenticated() &&
          exists(/databases/$(database)/documents/botChats/$(chatId)) &&
          fieldStr(get(/databases/$(database)/documents/botChats/$(chatId)).data, 'uid') == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          exists(/databases/$(database)/documents/botChats/$(chatId)) &&
          fieldStr(get(/databases/$(database)/documents/botChats/$(chatId)).data, 'uid') == request.auth.uid;
      }
    }

    // Abuse reports (bots and bot comments) — members create, only the
    // platform admin can read or manage them.
    match /botReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'reporterUid') == request.auth.uid;
    }

    // ======================================================================
    // Direct Share (file handoff via 6-character code or QR link)
    //
    // The document ID IS the share code (unguessable: 31^6 ≈ 887 million
    // combinations, generated with crypto.getRandomValues). Anyone signed in
    // may READ a share (they must present the code anyway), but only the
    // owner can add/remove files or close the share. File bytes live on
    // Cloudinary; Firestore only stores metadata.
    // ======================================================================
    match /directShares/{shareId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'ownerId') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        fieldStr(resource.data, 'ownerId') == request.auth.uid;
    }

    // ======================================================================
    // Secure in-app file store (fileBlobs)
    //
    // Real file BYTES (base64 chunks) for attachments when Cloudinary accepts
    // an upload but the account's security setting blocks its DELIVERY
    // (401 "deny or ACL failure" on PDF/ZIP). The uploader stores bytes;
    // any signed-in member can read them (same visibility as Cloudinary
    // public URLs). Every chunk repeats ownerId so writes never need a get()
    // on the parent — a batch that creates parent + chunks atomically
    // validates against the request itself.
    // ======================================================================
    match /fileBlobs/{blobId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        fieldStr(request.resource.data, 'ownerId') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        fieldStr(resource.data, 'ownerId') == request.auth.uid;

      match /chunks/{chunkId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated() &&
          fieldStr(request.resource.data, 'ownerId') == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          fieldStr(resource.data, 'ownerId') == request.auth.uid;
      }
    }
  }
}
